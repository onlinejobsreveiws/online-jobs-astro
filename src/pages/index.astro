---
import Layout from '../layouts/Layout.astro';
import platforms from '../data/platforms.json';

const clusters = [...new Set(platforms.map((p: any) => p.cluster))];
---

<Layout title="Make Money Online in Kenya - Verified Reviews">
  <section class="bg-blue-700 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold mb-6">Make Money Online in Kenya</h1>
      <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto mb-10">
        Verified reviews of forex brokers, AI training platforms, freelance sites, and investment apps.
      </p>
      <a href="#categories" class="inline-block bg-white text-blue-700 font-bold py-4 px-8 rounded-full hover:bg-gray-100 transition">
        Explore Platforms
      </a>
    </div>
  </section>

  <section id="categories" class="py-16 max-w-7xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Browse by Category</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {clusters.map((cluster: string) => (
        <a href={`/jobs/${cluster}`} class="p-6 bg-gray-50 rounded-xl border hover:border-blue-500 hover:shadow-md transition text-center capitalize font-semibold text-gray-700">
          {cluster.replace('_', ' ')}
        </a>
      ))}
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-gray-900 mb-8">Latest Reviews</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {platforms.slice(0, 6).map((platform: any) => (
          <a href={`/jobs/${platform.cluster}/${platform.slug}`} class="bg-white p-6 rounded-xl shadow-sm border hover:shadow-lg transition group">
            <span class="text-xs font-bold text-blue-600 uppercase">{platform.category}</span>
            <h3 class="text-xl font-bold text-gray-900 mt-2 mb-3 group-hover:text-blue-600">{platform.name}</h3>
            <p class="text-gray-600 text-sm line-clamp-3">{platform.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>