---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us">
  <div class="max-w-3xl mx-auto px-4 py-12 prose prose-lg">
    <h1>Contact Us</h1>
    <p>Have a question about a review? Want to suggest a new platform? Or just want to say hello? We'd love to hear from you!</p>
    
    <h2>Get in Touch</h2>
    <p>You can reach us via email at: <strong>contactonlinejobsreveiws@gmail.com</strong></p>
    
    <h2>Follow Us</h2>
    <p>Stay updated with the latest online job opportunities by following us on our social media channels.</p>
    
    <p>We aim to respond to all inquiries within 24-48 hours.</p>
  </div>
</Layout>