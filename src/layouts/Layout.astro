---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Discover legitimate ways to make money online in Kenya.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | OnlineJobsReveiws.co.ke </title>

    <!-- REPLACEMENT_PLACEHOLDER_GOOGLE_SEARCH_CONSOLE -->
    <!-- REPLACEMENT_PLACEHOLDER_GOOGLE_ANALYTICS -->
    <!-- REPLACEMENT_PLACEHOLDER_ADSENSE -->
  </head>
  <body class="flex flex-col min-h-screen bg-gray-50 text-gray-900">
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <a href="/" class="text-2xl font-bold text-blue-700">
            OnlineJobs<span class="text-gray-900">Reveiws</span>.co.ke
          </a>
          <nav class="hidden md:flex space-x-8">
            <a href="/jobs/freelancing" class="text-gray-600 hover:text-blue-600 font-medium">Freelancing</a>
            <a href="/jobs/ai-training" class="text-gray-600 hover:text-blue-600 font-medium">AI Training</a>
            <a href="/jobs/forex-trading" class="text-gray-600 hover:text-blue-600 font-medium">Forex</a>
            <a href="/jobs/crypto" class="text-gray-600 hover:text-blue-600 font-medium">Crypto</a>
            <a href="/jobs/surveys-tasks" class="text-gray-600 hover:text-blue-600 font-medium">Surveys</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-gray-900 text-gray-300 py-12 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
        <div>
          <h3 class="text-white text-lg font-bold mb-4">OnlineJobsReveiws</h3>
          <p class="text-sm">Your trusted guide to legitimate online earning opportunities in Kenya.</p>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-4">Categories</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/jobs/freelancing" class="hover:text-white">Freelancing</a></li>
            <li><a href="/jobs/ai-training" class="hover:text-white">AI Training</a></li>
            <li><a href="/jobs/forex-trading" class="hover:text-white">Forex Trading</a></li>
            <li><a href="/jobs/crypto" class="hover:text-white">Crypto & Investing</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-4">Company</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/about" class="hover:text-white">About Us</a></li>
            <li><a href="/contact" class="hover:text-white">Contact Us</a></li>
            <li><a href="/privacy-policy" class="hover:text-white">Privacy Policy</a></li>
            <li><a href="/disclaimer" class="hover:text-white">Risk Disclaimer</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs text-gray-400">Trading involves risk. Content is for educational purposes only.</p>
        </div>
      </div>
      <div class="text-center text-sm text-gray-500 mt-12 pt-8 border-t border-gray-800">
        &copy; {new Date().getFullYear()} OnlineJobsReveiws.co.ke
      </div>
    </footer>
  </body>
</html>